<Window x:Class="LangRXDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LangRX Test" Height="400" Width="500">
    <!-- DynamicResource repaints when LangRXDictionary.SetLanguage changes culture. -->
    <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource Greeting}"
                   FontSize="48"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="20" />
        <Button Content="{DynamicResource ButtonChange}"
                Padding="15,8"
                Margin="20"
                FontSize="16"
                HorizontalAlignment="Center"
                Click="ChangeLanguage_Click" />
    </StackPanel>
</Window>