<Application x:Class="LangRXDemo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LangRXDemo"
             xmlns:lang="clr-namespace:LangRX;assembly=LangRX"
             StartupUri="MainWindow.xaml"
             >
    <Application.Resources>
        <ResourceDictionary>
            <!-- LangRX dictionary: source of keys for DynamicResource lookups. -->
            <ResourceDictionary.MergedDictionaries>
                <lang:LangRXDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>